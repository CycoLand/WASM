@using BlazorWebLLM.Services
@using Cycod.Core.Chat
@using Cycod.Core.FunctionCalling
@using Cycod.Core.Tools
@using Microsoft.Extensions.AI
@inject IWebLLMChatService ChatService
@inject IModelManagerService ModelManager
@inject IJSRuntime JS
@implements IDisposable

<div class="chat-container">
    <div class="chat-messages" @ref="_messagesContainer">
        @if (!_displayMessages.Any())
        {
            <div class="chat-welcome">
                <h4>👋 Welcome to Browser LLM Chat!</h4>
            </div>
        }
        @foreach (var message in _displayMessages)
        {
            @if (message.IsTool)
            {
                <div class="chat-message tool">
                    <div class="message-content tool-call">
                        <span class="tool-icon">🔧</span>
                        <span class="tool-name">@message.FunctionName</span>
                        <span class="tool-result">@message.Text</span>
                    </div>
                </div>
            }
            else
            {
                <div class="chat-message @(message.IsUser ? "user" : "assistant")">
                    <div class="message-content">
                        @if (message == _displayMessages.LastOrDefault() && _isGenerating && !message.IsUser)
                        {
                            @((MarkupString)FormatMessage(message.Text))
                            <span class="typing-cursor">▋</span>
                        }
                        else
                        {
                            @((MarkupString)FormatMessage(message.Text))
                        }
                    </div>
                </div>
            }
        }
    </div>

    <div class="chat-input-area">
        <textarea @bind="_userInput" 
                  @bind:event="oninput"
                  @onkeydown="HandleKeyDown"
                  placeholder="Type your message... (Shift+Enter for new line)"
                  disabled="@(!ChatService.IsReady || _isGenerating)"
                  rows="2"></textarea>
        <button class="btn btn-primary" 
                @onclick="SendMessage" 
                disabled="@(!ChatService.IsReady || _isGenerating || string.IsNullOrWhiteSpace(_userInput))">
            @if (_isGenerating)
            {
                <span class="spinner-border spinner-border-sm" role="status"></span>
            }
            else
            {
                <text>Send</text>
            }
        </button>
    </div>

    <div class="chat-stats">
        <span>🔧 @_toolCount tools available</span>
        @if (_generationTimeMs > 0)
        {
            <span>⏱️ @_generationTimeMs.ToString("F0") ms</span>
        }
    </div>
</div>

@code {
    // Use explicit type alias to avoid ambiguity with Microsoft.Extensions.Logging
    private Cycod.Core.Providers.ILoggerProvider? _logger;
    
    private List<DisplayMessage> _displayMessages = new();
    private string _userInput = "";
    private string _currentStreamingText = "";
    private bool _isGenerating;
    private double _generationTimeMs;
    private int _toolCount;
    private ElementReference _messagesContainer;

    private FunctionCallingChat? _chat;

    private class DisplayMessage
    {
        public string Text { get; set; } = "";
        public string FunctionName { get; set; } = "";
        public bool IsUser { get; set; }
        public bool IsTool { get; set; }
    }

    protected override void OnInitialized()
    {
        ModelManager.ModelStateChanged += OnModelStateChanged;
    }

    private void OnModelStateChanged(object? sender, bool isLoaded)
    {
        if (isLoaded)
        {
            InitializeChat();
        }
        else
        {
            _chat = null;
        }
        InvokeAsync(StateHasChanged);
    }

    private void InitializeChat()
    {
        _logger = new BrowserLoggerProvider(Cycod.Core.Providers.LogLevel.Info);
        var functionFactory = new FunctionFactory(_logger);

        // Register built-in tools
        functionFactory.AddFunctions(new DateAndTimeHelperFunctions());

        _toolCount = functionFactory.GetAITools().Count();

        var systemPrompt = BuildSystemPrompt();

        _chat = new FunctionCallingChat(
            ChatService,
            systemPrompt,
            functionFactory,
            _logger);

        _displayMessages.Clear();
        Console.WriteLine($"[Chat] Initialized with {_toolCount} tools");
    }

    private string BuildSystemPrompt()
    {
        return $"""
            You are a helpful AI assistant running entirely in the browser using WebLLM.
            Everything runs locally - no data is sent to any server.

            Current date and time: {DateTime.Now:dddd, MMMM d, yyyy 'at' h:mm tt}
            Current timezone: {TimeZoneInfo.Local.DisplayName}

            Available tools:
            - GetCurrentDate: Get the current date
            - GetCurrentTime: Get the current time
            - GetCurrentDateTime: Get the current date and time
            - GetDayOfWeek: Get the current day of the week

            When asked about the current time, date, or day, use the appropriate tool.
            When asked what tools you have access to, list the tools above.
            Always be helpful, accurate, and concise.
            """;
    }

    private async Task SendMessage()
    {
        var hasNoInput = string.IsNullOrWhiteSpace(_userInput);
        if (hasNoInput || !ChatService.IsReady || _isGenerating) return;

        if (_chat == null)
        {
            InitializeChat();
        }

        var userMessage = _userInput.Trim();
        _userInput = "";
        _currentStreamingText = "";

        // Add user message to display
        _displayMessages.Add(new DisplayMessage { Text = userMessage, IsUser = true });
        StateHasChanged();
        await ScrollToBottom();

        _isGenerating = true;
        var startTime = DateTime.UtcNow;

        try
        {
            var response = await _chat!.SendMessageAsync(
                userMessage,
                onStreamUpdate: text =>
                {
                    _currentStreamingText += text;
                    // Update the last assistant message or add a new one
                    var lastMessage = _displayMessages.LastOrDefault();
                    if (lastMessage != null && !lastMessage.IsUser && !lastMessage.IsTool)
                    {
                        lastMessage.Text = _currentStreamingText;
                    }
                    else
                    {
                        _displayMessages.Add(new DisplayMessage { Text = _currentStreamingText, IsUser = false });
                    }
                    InvokeAsync(async () =>
                    {
                        StateHasChanged();
                        await ScrollToBottom();
                    });
                },
                onFunctionCall: (name, args, result) =>
                {
                    if (result != null)
                    {
                        _displayMessages.Add(new DisplayMessage
                        {
                            Text = result.ToString() ?? "",
                            FunctionName = name,
                            IsTool = true
                        });
                        InvokeAsync(async () =>
                        {
                            StateHasChanged();
                            await ScrollToBottom();
                        });
                    }
                });

            _generationTimeMs = (DateTime.UtcNow - startTime).TotalMilliseconds;

            // Ensure final response is displayed
            if (!string.IsNullOrEmpty(response))
            {
                var lastMessage = _displayMessages.LastOrDefault();
                if (lastMessage != null && !lastMessage.IsUser && !lastMessage.IsTool)
                {
                    lastMessage.Text = response;
                }
                else
                {
                    _displayMessages.Add(new DisplayMessage { Text = response, IsUser = false });
                }
            }
        }
        catch (Exception ex)
        {
            _displayMessages.Add(new DisplayMessage { Text = $"❌ Error: {ex.Message}", IsUser = false });
            Console.WriteLine($"[Chat] Error: {ex}");
        }
        finally
        {
            _isGenerating = false;
            _currentStreamingText = "";
            StateHasChanged();
            await ScrollToBottom();
        }
    }

    private static string FormatMessage(string text)
    {
        // Basic formatting: convert newlines to <br> and escape HTML
        return System.Net.WebUtility.HtmlEncode(text).Replace("\n", "<br />");
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        var isEnterWithoutShift = e.Key == "Enter" && !e.ShiftKey;
        if (isEnterWithoutShift)
        {
            await SendMessage();
        }
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", "document.querySelector('.chat-messages')?.scrollTo(0, document.querySelector('.chat-messages')?.scrollHeight)");
        }
        catch
        {
            // Ignore scroll errors
        }
    }

    public void Dispose()
    {
        ModelManager.ModelStateChanged -= OnModelStateChanged;
    }
}
