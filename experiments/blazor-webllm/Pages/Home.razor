@page "/"
@using BlazorWebLLM.Components

<PageTitle>Browser LLM Chat</PageTitle>

<div class="container-fluid h-100">
    <div class="row">
        <div class="col-12">
            <header class="text-center py-3 border-bottom mb-3">
                <h1 class="h3">🧠 Browser LLM Chat</h1>
            </header>
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-lg-10 offset-lg-1">
            <details class="how-it-works mb-3">
                <summary><strong>💡 How it works</strong></summary>
                <div class="details-content">
                    Models run 100% locally using 
                    <a href="https://webllm.mlc.ai/" target="_blank">WebLLM</a> + 
                    <a href="https://developer.mozilla.org/en-US/docs/Web/API/WebGPU_API" target="_blank">WebGPU</a>. 
                    Your data never leaves your device!
                </div>
            </details>

            <ModelSelector />
            
            <div class="mt-3">
                <ChatInterface />
            </div>
        </div>
    </div>
</div>
